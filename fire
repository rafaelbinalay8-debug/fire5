local function addToList(text, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 25)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = scroll
    
    label.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if setclipboard then
                setclipboard(text)
                label.TextColor3 = Color3.fromRGB(0, 255, 0)
                task.wait(0.2)
                label.TextColor3 = color or Color3.new(1, 1, 1)
            end
        end
    end)
end

local function scanDescendants(root)
    local count = 0
    for _, obj in pairs(root:GetDescendants()) do
        local name = obj.Name:lower()
        
        -- Cari string yang sering dipake buat item/shop
        if string.find(name, "item") or string.find(name, "shop") or 
           string.find(name, "buy") or string.find(name, "product") or
           string.find(name, "asset") or string.find(name, "id") then
            
            local id = nil
            -- Coba tarik Attribute atau Value yang nyimpen ID
            if obj:IsA("ValueBase") then
                id = obj.Value
            elseif obj:IsA("Model") or obj:IsA("BasePart") then
                id = obj:GetAttribute("ItemId") or obj:GetAttribute("ID") or obj:GetAttribute("AssetId")
            end
            
            if id then
                addToList(obj.Name .. " | ID: " .. tostring(id), Color3.fromRGB(255, 200, 100))
                count = count + 1
            else
                addToList(obj.Name .. " | NO_ID_ATTR", Color3.fromRGB(150, 150, 150))
                count = count + 1
            end
        end
    end
    return count
end

